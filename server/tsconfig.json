{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true   // ✅ add this — skips type checking node_modules
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}